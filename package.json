{
  "name": "gritorquit",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@8.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "node --test --experimental-strip-types packages/notes-ui-web/src/lib/*.test.ts",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "ci:local": "turbo run lint type-check build && pnpm test",
    "cms:sync": "npx tsx scripts/sync-features.ts",
    "db:generate": "pnpm --filter  @gritorquit/db run generate",
    "postinstall": "pnpm run db:generate",
    "build:web": "turbo run build --filter=web",
    "build:cms": "turbo run build --filter=cms",
    "desktop:packages": "./scripts/build-desktop-packages.sh",
    "desktop:packages:linux": "./scripts/build-desktop-packages.sh --linux-only",
    "mobile:check": "./scripts/check-mobile-apk-prerelease.sh",
    "mobile:check:debug": "./scripts/check-mobile-apk-prerelease.sh --with-debug-apk",
    "mobile:start:go": "pnpm --filter mobile run start:go",
    "mobile:start:dev-client": "pnpm --filter mobile run start:dev-client",
    "mobile:apk:local": "./scripts/build-mobile-apk.sh",
    "mobile:apk:fast": "./scripts/build-mobile-apk.sh --skip-install --skip-prebuild --skip-gradle-clean",
    "android": "pnpm --filter mobile run android",
    "ios": "pnpm --filter mobile run ios",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "mobile>react": "18.3.1",
      "mobile>react-dom": "18.3.1",
      "mobile>react-native": "0.76.7",
      "react-native-reanimated>react": "18.3.1",
      "react-native-safe-area-context>react": "18.3.1",
      "mobile>@types/react": "^18.3.12",
      "mobile>@types/react-dom": "^18.3.1",
      "@types/react": "^19.0.8",
      "@types/react-dom": "^19.0.3",
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "metro": "0.81.0",
      "metro-config": "0.81.0",
      "metro-resolver": "0.81.0",
      "metro-core": "0.81.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.3.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4",
    "rollup-plugin-javascript-obfuscator": "^1.0.4",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@studio-freight/react-lenis": "^0.0.47",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/postcss": "^4.1.17",
    "agentkeepalive": "^4.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~52.0.49",
    "form-data-encoder": "^4.1.0",
    "formdata-node": "^6.0.3",
    "framer-motion": "^12.26.2",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "razorpay": "^2.9.6",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=18"
  },
  "version": "1.0.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  }
}

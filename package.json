{
  "name": "planner",
  "private": true,
  "packageManager": "pnpm@8.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "cms:sync": "npx tsx scripts/sync-features.ts",
    "db:generate": "pnpm --filter @planner/db run generate",
    "postinstall": "pnpm run db:generate",
    "build:web": "turbo run build --filter=web",
    "build:cms": "turbo run build --filter=cms"
  },
  "pnpm": {
    "overrides": {
      "mobile>react": "18.3.1",
      "mobile>react-dom": "18.3.1",
      "mobile>react-native": "0.76.6",
      "react-native-reanimated>react": "18.3.1",
      "react-native-safe-area-context>react": "18.3.1",
      "mobile>@types/react": "^18.3.12",
      "mobile>@types/react-dom": "^18.3.1",
      "@types/react": "^19.0.8",
      "@types/react-dom": "^19.0.3",
      "react": "19.0.0",
      "react-dom": "19.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "prettier": "^3.7.4",
    "react-native-worklets-core": "^1.6.2",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@studio-freight/react-lenis": "^0.0.47",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/postcss": "^4.1.17",
    "agentkeepalive": "^4.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "form-data-encoder": "^4.1.0",
    "formdata-node": "^6.0.3",
    "framer-motion": "^12.26.2",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "razorpay": "^2.9.6",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// *
/// * --------------------
/// * CORE AUTH / PROFILE
/// * --------------------
model User {
  id                  String               @id
  email               String               @unique
  role                UserRole             @default(user)
  tier                String               @default("Free Tier")
  customAiLimit       Int?
  expoPushToken       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordHash        String?
  emailVerified       DateTime?            @map("email_verified")
  name                String?
  image               String?
  accounts            Account[]
  aiUsage             AiUsage?
  aiUsageLogs         AiUsageLog[]
  knownDevices        AuthKnownDevice[]
  dailyNotes          DailyNote[]
  entries             Entry[]              @relation("UserEntries")
  GithubProject       GithubProject[]
  habitLogs           HabitLog[]
  habits              Habit[]
  notes               Note[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  plans               Plan[]
  sessions            Session[]
  dailySessions       DailySession[]
  studyPlaylists      StudyPlaylist[]
  studyResources      StudyResource[]
  tracks              Track[]
  studyVideos         StudyVideo[]
  weeklyReflections   WeeklyReflection[]
  legacySubscription  Subscription?
  supportMessages     SupportMessage[]
  tasks               Task[]
  profile             UserProfile?
  stats               UserStats?
  subscriptions       UserSubscription[]
  refreshTokens       RefreshToken[]

  @@index([role])
  @@index([tier])
  @@map("users")
}

model AuthLoginAttempt {
  id             String    @id @default(cuid())
  key            String    @unique
  email          String
  ip             String?
  count          Int       @default(1)
  firstAttemptAt DateTime
  lastAttemptAt  DateTime
  lastAlertAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@map("auth_login_attempts")
}

model AuthKnownDevice {
  id           String   @id @default(cuid())
  userId       String
  fingerprint  String
  ip           String?
  userAgent    String?
  locationHint String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("auth_known_devices")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  deviceId  String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("auth_refresh_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserProfile {
  userId    String  @id
  name      String?
  avatarUrl String?
  bio       String?
  locale    String?
  timezone  String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// *
/// * Move high-write counter out of User to avoid hot-row contention
model AiUsage {
  userId    String    @id
  count     Int       @default(0)
  resetAt   DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resetAt])
  @@map("ai_usage")
}

/// *
/// * Append-only log for analytics/audit (cheap writes)
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

/// *
/// * Snapshot / read-optimized stats for fast dashboard reads
model UserStats {
  userId         String    @id
  totalPlans     Int       @default(0)
  totalTasks     Int       @default(0)
  completedTasks Int       @default(0)
  activeHabits   Int       @default(0)
  currentStreak  Int       @default(0)
  lastActiveAt   DateTime?
  neuralCredits  Int       @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Plan {
  id             String     @id @default(uuid())
  userId         String
  title          String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  totalTasks     Int        @default(0)
  completedTasks Int        @default(0)
  progress       Int        @default(0)
  isArchived     Boolean    @default(false)
  status         PlanStatus @default(active)
  pausedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([userId, isArchived])
  @@index([userId, updatedAt])
  @@map("plans")
}

model Task {
  id               String     @id @default(uuid())
  planId           String?
  userId           String
  title            String
  description      String?
  date             DateTime?
  dueDate          DateTime?
  completed        Boolean    @default(false)
  status           TaskStatus @default(pending)
  priority         Priority?
  estimatedMinutes Int?
  timeSpentMinutes Int?       @default(0)
  metadata         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  subtasks         Subtask[]
  tags             TaskTag[]
  plan             Plan?      @relation(fields: [planId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([planId, completed])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  tasks     TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId    String
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model Habit {
  id        String     @id @default(uuid())
  userId    String
  title     String
  icon      String?    @default("circle")
  color     String?    @default("text-blue-500")
  order     Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())
  logs      HabitLog[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("habits")
}

model MobileSyncDeletion {
  id        BigInt   @id @default(autoincrement())
  userId    String
  tableName String
  recordId  String
  deletedAt DateTime @default(now())

  @@unique([userId, tableName, recordId])
  @@index([userId, deletedAt])
  @@map("mobile_sync_deletions")
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

model DailyNote {
  id      String   @id @default(uuid())
  userId  String
  date    DateTime
  content String?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_notes")
}

model ContentType {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  schema    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  entries   Entry[]

  @@map("content_types")
}

model Entry {
  id            String      @id @default(cuid())
  contentTypeId String
  slug          String?     @unique
  title         String?
  status        EntryStatus @default(draft)
  excerpt       String?
  thumbnailUrl  String?
  data          Json
  locale        String?     @default("en")
  requiresTier  String?
  publishedAt   DateTime?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contentType   ContentType @relation(fields: [contentTypeId], references: [id])
  createdBy     User        @relation("UserEntries", fields: [createdById], references: [id], onDelete: Cascade)
  revisions     Revision[]

  @@index([slug])
  @@index([contentTypeId, publishedAt])
  @@map("entries")
}

model Revision {
  id        String   @id @default(cuid())
  entryId   String
  data      Json
  createdBy String
  createdAt DateTime @default(now())
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@map("revisions")
}

model Media {
  id         String   @id @default(cuid())
  key        String   @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([uploadedBy])
  @@map("media")
}

model Product {
  id                  String             @id @default(cuid())
  key                 String             @unique
  name                String
  description         String?
  price               Int
  currency            String             @default("INR")
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  featuresList        Json?
  localDbAllowed      Boolean            @default(false)
  offlineEnabled      Boolean            @default(false)
  offlineMaxDuration  Int                @default(24)
  tokenExpiryDuration Int                @default(48)
  orders              Order[]
  productFeatures     ProductFeature[]
  subscriptions       UserSubscription[]

  @@map("products")
}

model Feature {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  productFeatures ProductFeature[]

  @@map("features")
}

model ProductFeature {
  id        String  @id @default(cuid())
  productId String
  featureId String
  value     Json
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, featureId])
  @@map("product_features")
}

model CmsAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  description String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@map("cms_audit_logs")
}

model UserSubscription {
  id               String             @id @default(cuid())
  userId           String
  productId        String
  status           SubscriptionStatus
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  provider         String?
  providerSubId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  product          Product            @relation(fields: [productId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_subscriptions")
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  productId         String?
  amount            Int
  currency          String   @default("INR")
  providerOrderId   String?  @unique
  providerPaymentId String?
  status            String
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product? @relation(fields: [productId], references: [id])
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@map("orders")
}

/// *
/// * Legacy subscription: plan to migrate off
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomer   String?   @db.VarChar(191)
  stripeSubId      String?   @unique @db.VarChar(191)
  priceId          String?
  status           String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomer])
  @@index([stripeSubId])
  @@map("subscriptions")
}

model Track {
  id                      String      @id @default(cuid())
  userId                  String
  type                    TrackType
  title                   String
  description             String?
  status                  TrackStatus @default(ACTIVE)
  priority                Int         @default(0)
  targetDate              DateTime?
  progressPercentage      Float       @default(0)
  confidenceScore         Float       @default(0)
  totalTimeMinutes        Int         @default(0)
  lastActiveAt            DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  dailyAllocationMinutes  Int?
  estimatedCompletionDate DateTime?
  remainingMinutes        Int         @default(0)
  totalDurationMinutes    Int         @default(0)
  link                    String?
  metadata                Json?
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  units                   Unit[]

  @@index([userId])
  @@map("study_tracks")
}

model Unit {
  id                     String             @id @default(cuid())
  trackId                String
  title                  String
  description            String?
  type                   UnitType           @default(VIDEO)
  orderIndex             Int                @default(0)
  estimatedEffort        Effort             @default(MEDIUM)
  durationMinutes        Int?
  actualTimeSpentMinutes Int?               @default(0)
  status                 UnitStatus         @default(BACKLOG)
  confidenceRating       Int?
  difficultyRating       Int?
  lastCompletedAt        DateTime?
  takeaways              Json?
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  durationSeconds        Int?               @default(0)
  lastWatchedAt          DateTime?
  notes                  Json?
  totalWatchedSeconds    Int?               @default(0)
  watchPercentage        Float?             @default(0)
  todayGoalMinutes       Int?
  revisions              RevisionSchedule[]
  sessions               UnitSession[]
  track                  Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, status])
  @@map("study_units")
}

model UnitSession {
  id             String    @id @default(cuid())
  unitId         String
  userId         String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  watchedSeconds Int       @default(0)
  isPaused       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("study_unit_sessions")
}

model DailySession {
  id                 String      @id @default(cuid())
  userId             String
  date               DateTime
  energyLevel        EnergyLevel
  totalTimeMinutes   Int         @default(0)
  tasksCompleted     Int         @default(0)
  cognitiveLoadScore Float       @default(0)
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_daily_sessions")
}

model RevisionSchedule {
  id             String   @id @default(cuid())
  unitId         String
  nextRevisionAt DateTime
  revisionCount  Int      @default(0)
  intervalLevel  Int      @default(0)
  createdAt      DateTime @default(now())
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, nextRevisionAt])
  @@map("study_revision_schedules")
}

model WeeklyReflection {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  answers     Json
  moodScore   Int?
  stressLevel Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_weekly_reflections")
}

model StudyPlaylist {
  id              String       @id @default(cuid())
  userId          String
  youtubeId       String
  title           String
  description     String?
  thumbnailUrl    String?
  channelName     String?
  channelId       String?
  totalVideos     Int          @default(0)
  completedVideos Int          @default(0)
  status          StudyStatus  @default(in_progress)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos          StudyVideo[]

  @@unique([userId, youtubeId])
  @@map("study_playlists")
}

model StudyVideo {
  id           String          @id @default(cuid())
  userId       String
  playlistId   String?
  youtubeId    String
  title        String
  description  String?
  thumbnailUrl String?
  channelName  String?
  durationSec  Int             @default(0)
  position     Int             @default(0)
  status       StudyStatus     @default(not_started)
  progressSec  Int             @default(0)
  timeSpentSec Int             @default(0)
  notes        Json?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resources    StudyResource[]
  playlist     StudyPlaylist?  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, youtubeId, playlistId])
  @@index([userId, status])
  @@map("study_videos")
}

model StudyResource {
  id          String       @id @default(cuid())
  videoId     String
  userId      String
  title       String
  url         String
  type        ResourceType @default(other)
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       StudyVideo   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("study_resources")
}

model Note {
  id                String             @id @default(cuid())
  userId            String
  title             String?
  content           Json?
  category          NoteCategory       @default(GENERAL)
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  versions          BlueprintVersion[]
  githubProject     GithubProject?     @relation("ProjectRequirements")
  projectSystemFlow GithubProject?     @relation("ProjectSystemFlow")
  projectUserFlow   GithubProject?     @relation("ProjectUserFlow")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("notes")
}

model BlueprintVersion {
  id                     String             @id @default(cuid())
  noteId                 String
  versionNumber          Int
  contentSnapshot        Json?
  createdAt              DateTime           @default(now())
  note                   Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  iterationsAsPrd        ProjectIteration[] @relation("PrdVersion")
  iterationsAsSystemFlow ProjectIteration[] @relation("SystemFlowVersion")
  iterationsAsUserFlow   ProjectIteration[] @relation("UserFlowVersion")

  @@index([noteId])
  @@map("blueprint_versions")
}

model ProjectIteration {
  id                  String             @id @default(cuid())
  projectId           String
  name                String
  status              String             @default("ACTIVE")
  sdlcPhaseId         String             @default("PLANNING")
  methodology         ProjectMethodology
  prdVersionId        String?
  userFlowVersionId   String?
  systemFlowVersionId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  features            GithubFeature[]
  prdVersion          BlueprintVersion?  @relation("PrdVersion", fields: [prdVersionId], references: [id])
  project             GithubProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  systemFlowVersion   BlueprintVersion?  @relation("SystemFlowVersion", fields: [systemFlowVersionId], references: [id])
  userFlowVersion     BlueprintVersion?  @relation("UserFlowVersion", fields: [userFlowVersionId], references: [id])

  @@index([projectId])
  @@map("project_iterations")
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("support_messages")
}

model GithubProject {
  id                 String              @id @default(cuid())
  userId             String
  name               String
  description        String?
  lifecycle          ProjectLifecycle    @default(AGILE)
  githubRepo         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  requirementsNoteId String?             @unique
  methodology        ProjectMethodology?
  systemFlowNoteId   String?             @unique
  userFlowNoteId     String?             @unique
  prdVerified        Boolean             @default(false)
  projectStage       ProjectStage        @default(REQUIREMENTS)
  systemFlowVerified Boolean             @default(false)
  userFlowVerified   Boolean             @default(false)
  activeIterationId  String?
  features           GithubFeature[]
  requirementsNote   Note?               @relation("ProjectRequirements", fields: [requirementsNoteId], references: [id])
  systemFlowNote     Note?               @relation("ProjectSystemFlow", fields: [systemFlowNoteId], references: [id])
  userFlowNote       Note?               @relation("ProjectUserFlow", fields: [userFlowNoteId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  iterations         ProjectIteration[]

  @@index([userId])
  @@map("github_projects")
}

model GithubFeature {
  id                 String            @id @default(cuid())
  projectId          String
  title              String
  description        String?
  githubIssueId      Int?
  githubBranch       String?
  githubPullReq      Int?
  hasArchitectureDoc Boolean           @default(false)
  hasTestPlan        Boolean           @default(false)
  learningNotes      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  iterationId        String?
  sdlcPhaseId        String?           @default("START")
  status             String            @default("TODO")
  parentId           String?
  iteration          ProjectIteration? @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  parent             GithubFeature?    @relation("FeatureHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks           GithubFeature[]   @relation("FeatureHierarchy")
  project            GithubProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sdlcPhaseId])
  @@index([parentId])
  @@map("github_features")
}

/// *
/// * Enums
enum UserRole {
  user
  admin
  system
}

enum TaskStatus {
  pending
  in_progress
  blocked
  completed
  archived
}

enum Priority {
  low
  medium
  high
  urgent
}

enum EntryStatus {
  draft
  published
  archived
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}


{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@gritorquit/domain": ["../domain/index.ts"],
      "@gritorquit/domain/*": ["../domain/*"],
      "@gritorquit/dashboard-core": ["../dashboard-core/src/index.ts"],
      "@gritorquit/habits-ui-web": ["../habits-ui-web/src/index.ts"],
      "@gritorquit/study-ui-web": ["../study-ui-web/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

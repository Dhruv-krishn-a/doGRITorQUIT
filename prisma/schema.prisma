datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------

model User {
  id            String    @id // Maps to Supabase Auth ID
  email         String    @unique
  name          String?
  avatarUrl     String?
  tier          String    @default("Free tier")
  role          String    @default("user") // "admin" | "user"
  
  
  aiUsageCount  Int       @default(0)
  customAiLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---

  // Productivity
  plans      Plan[]
  tasks      Task[]
   
  // Habits & Notes (New System)
  habits     Habit[]
  habitLogs  HabitLog[] // Direct relation for faster querying
  dailyNotes DailyNote[]

  // CMS & Billing
  entries       Entry[]            @relation("UserEntries")
  orders        Order[]
  subscriptions UserSubscription[]
   
  // Legacy
  subscription  Subscription?

  @@map("users")
}

// --------------------------------------------------------
// PRODUCTIVITY SYSTEM (Plans, Tasks)
// --------------------------------------------------------

model Plan {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  // ✅ OPTIMIZATION
  @@index([userId, updatedAt])
  @@map("plans")
}

model Task {
  id               String    @id @default(uuid())
  planId           String?
  userId           String
  title            String
  description      String?
  date             DateTime?
  dueDate          DateTime?
  completed        Boolean   @default(false)
  status           String    @default("Pending")
  priority         String?
  estimatedMinutes Int?
  timeSpentMinutes Int?      @default(0)
  metadata         Json?     @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plan     Plan?     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks Subtask[]
  tags     TaskTag[]

  // ✅ OPTIMIZATION: Indexes moved INSIDE the model block
  @@index([userId, date])
  @@index([userId, status])
  
  @@map("tasks")
}

model Subtask {
  id        String    @id @default(uuid())
  taskId    String
  title     String
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  id        String    @id @default(uuid())
  taskId    String
  tagId     String
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@map("task_tags")
}

// --------------------------------------------------------
// HABIT & NOTE SYSTEM (New)
// --------------------------------------------------------

model Habit {
  id        String    @id @default(uuid())
  userId    String
  title     String
  icon      String?   @default("circle") // e.g., "dumbbell", "book"
  color     String?   @default("text-blue-500") // e.g., "text-blue-500"
  order     Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        String    @id @default(uuid())
  habitId   String
  userId    String
  date      DateTime // Stored as YYYY-MM-DD T00:00:00Z (Start of Day)
  completed Boolean   @default(false)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ OPTIMIZATION
  @@index([userId, date])
   
  // Constraint: One log per habit per day
  @@unique([habitId, date])
  @@map("habit_logs")
}

model DailyNote {
  id      String    @id @default(uuid())
  userId  String
  date    DateTime // Stored as YYYY-MM-DD
  content String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_notes")
}

// --------------------------------------------------------
// CMS SYSTEM
// --------------------------------------------------------

model ContentType {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  schema    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries Entry[]

  @@map("content_types")
}

model Entry {
  id            String    @id @default(cuid())
  contentTypeId String
  slug          String?   @unique
  title         String?
  status        String    @default("draft")
  data          Json
  locale        String?
  requiresTier  String?
  publishedAt   DateTime?
  createdById   String
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  contentType ContentType @relation(fields: [contentTypeId], references: [id])
  createdBy   User        @relation("UserEntries", fields: [createdById], references: [id])
  revisions   Revision[]

  @@index([slug])
  @@map("entries")
}

model Revision {
  id        String    @id @default(cuid())
  entryId   String
  data      Json
  createdBy String
  createdAt DateTime  @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("revisions")
}

model Media {
  id         String    @id @default(cuid())
  key        String    @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  @@map("media")
}

// --------------------------------------------------------
// BILLING & PRODUCTS
// --------------------------------------------------------

model Product {
  id          String    @id @default(cuid())
  key         String    @unique // e.g., "PRO_MONTHLY"
  name        String
  description String?
  price       Int // in paise
  currency    String    @default("INR")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productFeatures ProductFeature[]
  subscriptions   UserSubscription[]
  orders          Order[]
}

model Feature {
  id          String    @id @default(cuid())
  key         String    @unique // "AI_PLAN", "MAX_PLANS"
  description String?
  createdAt   DateTime  @default(now())

  productFeatures ProductFeature[]
}

model ProductFeature {
  id        String @id @default(cuid())
  productId String
  featureId String
  value     Json // { enabled: true } or { limit: 10 }

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([productId, featureId])
}

model UserSubscription {
  id               String    @id @default(cuid())
  userId           String
  productId        String
  status           String // active / canceled / past_due / trialing
  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime?
  provider         String? // e.g., "razorpay"
  providerSubId    String? // e.g., sub_123456
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // ✅ OPTIMIZATION
  @@index([userId, status])
}

model Order {
  id                String    @id @default(cuid())
  userId            String?
  productId         String?
  amount            Int
  currency          String    @default("INR")
  providerOrderId   String?   @unique
  providerPaymentId String?
  status            String
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

// --------------------------------------------------------
// LEGACY (Keep for backwards compatibility if needed)
// --------------------------------------------------------

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomer   String?   @db.VarChar(191)
  stripeSubId      String?   @unique @db.VarChar(191)
  priceId          String?
  status           String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([stripeCustomer])
  @@index([stripeSubId])
  @@map("subscriptions")
}
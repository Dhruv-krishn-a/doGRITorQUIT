                                 className="w-4 h-4 rounded border-[var(--border-color)] text-[var(--accent-color)] focus:ring-[var(--accent-color)] cursor-pointer" 
                               />
                               <span className="text-sm font-bold group-hover:text-[var(--accent-color)] transition-colors">Test Plan Defined</span>
                             </div>
                             <span className="text-[10px] font-black text-[var(--text-secondary)] uppercase tracking-widest">Required for Deploy</span>
                           </label>
                        )}
                        
                        {activeFeature.currentStage === 'LEARNING' && (
                          <div className="flex flex-col gap-3">
                            <div className="flex items-center justify-between ml-1">
                              <label className="text-[10px] font-black text-[var(--text-secondary)] uppercase tracking-[0.2em]">Retrospective Notes</label>
                              <button 
                                onClick={() => handleGenerateRetrospective(activeFeature.id)}
                                disabled={isGeneratingAI}
                                className="flex items-center gap-1.5 text-[9px] font-black uppercase tracking-widest text-[var(--bg-primary)] bg-[var(--accent-color)] hover:opacity-90 px-3 py-1.5 rounded-lg shadow-sm transition-all disabled:opacity-50"
                              >
                                {isGeneratingAI ? <Loader2 size={12} className="animate-spin" /> : <Sparkles size={12} />} 
                                {isGeneratingAI ? "Generating..." : "AI Auto-Generate"}
                              </button>
                            </div>
                            <textarea 
                              value={activeFeature.learningNotes || ""}
                              onChange={(e) => handleUpdateEvidence(activeFeature.id, { learningNotes: e.target.value })}
                              placeholder="What went well? What caused friction? What to improve next time?"
                              rows={8}
                              className="w-full bg-[var(--bg-primary)] border border-[var(--border-color)] focus:border-[var(--accent-color)] rounded-xl p-4 text-sm font-bold tracking-tight outline-none placeholder:text-[var(--text-secondary)]/30 resize-none"
                            />
                          </div>
                        )}
                        
                        {/* Fallback msg if early stage */}
                        {STAGES.findIndex(s => s.id === activeFeature.currentStage) < 2 && (
                          <div className="p-6 text-center border-2 border-dashed border-[var(--border-color)] rounded-xl bg-[var(--bg-primary)]">
                             <p className="text-[10px] font-black text-[var(--text-secondary)] uppercase tracking-widest leading-relaxed">
                               Complete early brainstorming. Formal artifacts will be required in Design & Testing phases.
                             </p>
                          </div>
                        )}
                      </div>
                    </div>

                    {/* Right Col: GitHub Evidence */}
                    <GithubEvidencePanel 
                      projectId={project.id} 
                      feature={activeFeature} 
                      repoName={project.githubRepo}
                      onUpdateEvidence={(updates) => handleUpdateEvidence(activeFeature.id, updates)}
                    />
                  </div>

                  {/* Stage Gate Footer */}
                  <div className="sticky bottom-0 mt-8 bg-[var(--bg-card)]/90 backdrop-blur-xl border border-[var(--border-color)] rounded-2xl p-6 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-6">
                    <div>
                      <h4 className="text-sm font-black uppercase tracking-tight text-[var(--text-primary)]">Ready for next stage?</h4>
                      <p className="text-[10px] font-black text-[var(--text-secondary)] uppercase tracking-widest mt-1">
                        {isStageReadyToAdvance() ? (
                          <span className="text-emerald-500">All requirements met. Clear for advance.</span>
                        ) : (
                          <span className="text-rose-500">Evidence missing. Check artifacts and GitHub links.</span>
                        )}
                      </p>
                    </div>
                    
                    <button 
                      onClick={() => {
                        const currentIdx = STAGES.findIndex(s => s.id === activeFeature.currentStage);
                        if (currentIdx < STAGES.length - 1) {
                          handleAdvanceStage(activeFeature.id, STAGES[currentIdx + 1].id);
                        }
                      }}
                      disabled={activeFeature.currentStage === 'LEARNING' || !isStageReadyToAdvance()}
                      className="px-8 py-4 bg-[var(--accent-color)] text-[var(--bg-primary)] rounded-xl font-black text-[10px] uppercase tracking-[0.2em] shadow-lg hover:opacity-90 transition-all active:scale-95 disabled:opacity-50 disabled:grayscale"
                    >
                      {activeFeature.currentStage === 'LEARNING' ? 'Journey Complete' : 'Advance Stage'}
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <div className="flex-1 flex flex-col items-center justify-center p-8 bg-[var(--bg-card)]/50 backdrop-blur-sm m-6 rounded-[2.5rem] border border-[var(--border-color)] overflow-y-auto custom-scrollbar">
               <div className="w-16 h-16 rounded-3xl bg-[var(--bg-secondary)] flex items-center justify-center mb-6 shadow-inner border border-[var(--border-color)]">
                 <Target size={24} className="text-[var(--accent-color)]" />
               </div>
               <h2 className="text-xl font-black text-[var(--text-primary)] uppercase tracking-tighter italic mb-2">Setup Your Features</h2>
               <p className="text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-widest text-center max-w-sm mb-8 leading-relaxed opacity-60">
                 Describe your project goals or specific modules below. If a GitHub repo is linked, we will scan your code and auto-map features to their current stages.
               </p>
               
               <div className="w-full max-w-lg space-y-6">
                 <textarea 
                   value={projectContext}
                   onChange={e => setProjectContext(e.target.value)}
                   placeholder="Describe what you've built so far, or what you plan to build... (e.g. 'This is a Next.js app with Stripe payments and a dashboard. Auth is already done.')"
                   rows={4}
                   className="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] focus:border-[var(--accent-color)] rounded-2xl p-4 text-sm font-bold tracking-tight outline-none placeholder:text-[var(--text-secondary)]/30 resize-none transition-all shadow-inner"
                 />

                 <div className="flex flex-col items-center gap-4">
                   <button 
                     onClick={handleGenerateInitialFeatures}
                     disabled={isGeneratingFeatures}
                     className="w-full flex items-center justify-center gap-3 px-8 py-5 rounded-2xl font-black text-[11px] uppercase tracking-[0.2em] bg-[var(--accent-color)] text-[var(--bg-primary)] shadow-xl shadow-[var(--accent-color)]/20 hover:opacity-90 disabled:opacity-50 transition-all active:scale-95 italic"
                   >
                     {isGeneratingFeatures ? <Loader2 size={18} className="animate-spin" /> : <Sparkles size={18} />}
                     {isGeneratingFeatures ? "Analyzing Project..." : "Scan & Analyze Project"}
                   </button>
                   
                   <p className="text-[9px] font-black text-[var(--text-secondary)] uppercase tracking-widest opacity-40 italic">
                     {project.githubRepo ? `Target: GitHub (${project.githubRepo})` : "No GitHub repo linked. AI will generate based on description only."}
                   </p>
                 </div>
               </div>
            </div>
          )}
        </section>
      </main>

      {/* Edit Feature Modal */}
      <AnimatePresence>
        {featureToEdit && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
            <motion.form 
              initial={{ scale: 0.95, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.95, opacity: 0 }}
              onSubmit={handleEditFeature}
              className="w-full max-w-md bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-[2rem] p-6 shadow-2xl"
            >
              <h3 className="text-sm font-black uppercase tracking-tight text-[var(--text-primary)] mb-4">Rename Feature</h3>
              <input 
                type="text"
                value={editFeatureTitle}
                onChange={e => setEditFeatureTitle(e.target.value)}
                className="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] focus:border-[var(--accent-color)] rounded-xl px-4 py-3 text-sm font-bold tracking-tight outline-none mb-6"
                autoFocus
              />
              <div className="flex items-center justify-end gap-3">
                <button 
                  type="button" 
                  onClick={() => setFeatureToEdit(null)}
                  className="px-4 py-2 text-[10px] font-black uppercase tracking-widest text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
                >
                  Cancel
                </button>
                <button 
                  type="submit" 
                  disabled={isEditing || !editFeatureTitle.trim()}
                  className="px-6 py-2 bg-[var(--accent-color)] text-[var(--bg-primary)] rounded-lg text-[10px] font-black uppercase tracking-[0.2em] hover:opacity-90 disabled:opacity-50 transition-all flex items-center gap-2"
                >
                  {isEditing && <Loader2 size={12} className="animate-spin" />}
                  Save Changes
                </button>
              </div>
            </motion.form>
          </div>
        )}
      </AnimatePresence>

      {/* Delete Feature Modal */}
      <AnimatePresence>
        {featureToDelete && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
            <motion.div 
              initial={{ scale: 0.95, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.95, opacity: 0 }}
              className="w-full max-w-md bg-[var(--bg-primary)] border border-rose-500/20 rounded-[2rem] p-8 shadow-2xl shadow-rose-500/10 text-center"
            >
              <div className="w-12 h-12 rounded-full bg-rose-500/10 border border-rose-500/20 flex items-center justify-center mx-auto mb-4 text-rose-500">
                <Trash2 size={20} />
              </div>
              <h3 className="text-lg font-black uppercase tracking-tighter text-[var(--text-primary)] italic mb-2">Delete Feature?</h3>
              <p className="text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-widest leading-relaxed mb-8">
                This action is irreversible. All linked evidence, artifacts, and retrospective notes will be permanently removed.
              </p>
              <div className="flex items-center justify-center gap-3">
                <button 
                  onClick={() => setFeatureToDelete(null)}
                  className="px-6 py-3 border border-[var(--border-color)] rounded-xl text-[10px] font-black uppercase tracking-widest text-[var(--text-primary)] hover:bg-[var(--bg-secondary)] transition-all"
                >
                  Cancel
                </button>
                <button 
                  onClick={() => handleDeleteFeature(featureToDelete)}
                  disabled={isDeleting}
                  className="px-6 py-3 bg-rose-500 text-white rounded-xl text-[10px] font-black uppercase tracking-[0.2em] hover:opacity-90 disabled:opacity-50 transition-all flex items-center gap-2 shadow-lg shadow-rose-500/20"
                >
                  {isDeleting && <Loader2 size={14} className="animate-spin" />}
                  Confirm Deletion
                </button>
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

    </div>
  );

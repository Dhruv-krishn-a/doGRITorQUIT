{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      
      "@/utils/*": ["utils/*"],
      "@/hooks/*": ["hooks/*"],
      
      // Feature aliases
      "@domain/*": ["../../packages/domain/*"],
      "@domain": ["../../packages/domain/index.ts"],
      "@features/*": ["features/*"],
      "@features": ["features/index.ts"],
      "@shared/*": ["shared/*"],
      "@shared": ["shared/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
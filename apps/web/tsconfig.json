{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2018",
    "lib": ["dom", "dom.iterable", "esnext"],

    "plugins": [{ "name": "next" }],
    
    "paths": {
      // Local App Aliases
      "@/*": ["./*"],
      "@/utils/*": ["./utils/*"],
      "@/hooks/*": ["./hooks/*"],
      
      // Domain Alias
      "@domain": ["../../packages/domain/index.ts"],
      "@domain/*": ["../../packages/domain/*"],

      // ✅ NEW: Database Alias (Fixes the build error)
      "@planner/db": ["../../packages/db/index.ts"],
      "@planner/db/*": ["../../packages/db/*"],
      
      // Config Alias
      "@planner/config": ["../../packages/config/index.ts"],

      // Feature aliases
      "@features/*": ["./features/*"],
      "@features": ["./features/index.ts"],
      "@shared/*": ["./shared/*"],
      "@shared": ["./shared/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
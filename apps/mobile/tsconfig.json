{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native",
    "moduleSuffixes": [
      ".native",
      ".ios",
      ".android",
      ""
    ],
    "paths": {
      "@/*": ["./*"],
      "@gritorquit/study-core": ["../../packages/study-core/src/index.ts"],
      "@gritorquit/habits-core": ["../../packages/habits-core/src/index.ts"],
      "@gritorquit/dashboard-core": ["../../packages/dashboard-core/src/index.ts"],
      "@gritorquit/api": ["../../packages/api/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "declarations.d.ts",
    "app.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}

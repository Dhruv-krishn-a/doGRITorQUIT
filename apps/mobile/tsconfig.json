{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "jsx": "react-native",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@gritorquit/study-core": [
        "../../packages/study-core/src/index.ts"
      ],
      "@gritorquit/habits-core": [
        "../../packages/habits-core/src/index.ts"
      ],
      "@gritorquit/dashboard-core": [
        "../../packages/dashboard-core/src/index.ts"
      ],

      "@gritorquit/domain": [
        "../../packages/domain/index.ts"
      ],
      "@gritorquit/domain/*": [
        "../../packages/domain/*"
      ],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "declarations.d.ts",
    "app.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
